# ============================================================
# Salin file ini menjadi .env, lalu isi kredensial Anda.
# JANGAN commit file .env.
# ============================================================

# Core
PROJECT_NAME="Simulasi Analisis AI Dashboard - Satu Data Depok"
APP_VERSION="2.0.0"

# LLM Selection: "gemini" atau "claude"
LLM_PROVIDER="gemini"

# Google Gemini API Settings
GEMINI_API_KEY="isi_api_key_gemini_di_sini"
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_FALLBACK_MODEL="gemini-3.8-flash"

# Anthropic Claude API Settings (opsional)
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-3-5-sonnet-20241022"

# Redis Cache
# Cara paling mudah: isi REDIS_URL dengan endpoint Upstash (rediss://...)
REDIS_URL=""
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_SSL=false
CACHE_KEY_PREFIX="tableau_insight:v2"
CACHE_EXPIRE_SECONDS=86400

# Scraper Configurations (fallback bila data tabel tidak tersedia)
SCRAPER_TIMEOUT_SECONDS=40
SCRAPER_SETTLE_SECONDS=7
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
ALLOWED_SCRAPE_HOSTS="public.tableau.com,satudata.depok.go.id"
MAX_TABLE_ROWS=1000

# Batas input LLM
LLM_MAX_INPUT_CHARS=24000

# Privasi: masking kolom PII sebelum dikirim ke LLM
MASK_PII=true
PII_KEYWORDS="nama,nik,nip,alamat,email,telepon,phone,hp,tanggal_lahir,tgl_lahir,tempat_lahir,no_kk,kk,pegawai,penduduk,no_hp,whatsapp"

# HTTP / keamanan
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://satudata.depok.go.id"
RATE_LIMIT_PER_MINUTE=30
